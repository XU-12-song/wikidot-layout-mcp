{
  "name": "wikidot-layout-mcp",
  "version": "0.1.0",
  "description": "Wikidot 版式设计 MCP 服务器：匿名源码获取、结构分析、FTML 渲染、浏览器截图与迭代闭环",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wikidot-layout-mcp": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ukwhatn/wikidot": "^4.5.3",
    "@wdprlib/ast": "^5.0.0",
    "@wdprlib/parser": "^6.0.0",
    "@wdprlib/render": "^5.0.0",
    "@wdprlib/runtime": "^2.0.0",
    "cheerio": "^1.2.0",
    "lru-cache": "^11.0.0",
    "p-limit": "^6.0.0",
    "playwright-core": "^1.64.0",
    "undici": "^7.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0"
  }
}
